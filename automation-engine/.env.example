# ---------------------------------------------------------------------------
# Automation engine configuration. Copy to .env and fill in the secrets.
# Never commit .env. Every variable below is read by src/config.ts.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Human-readable logs for local development (JSON when false).
LOG_PRETTY=false

# --- Data stores -------------------------------------------------------------
# docker compose overrides the hosts to "postgres" and "redis".
DATABASE_URL=postgresql://automation:automation@localhost:5432/automation?schema=public
DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6379

# --- Worker ------------------------------------------------------------------
WORKER_CONCURRENCY=50
WORKER_METRICS_PORT=9464
# Retries after the first attempt (total attempts = MAX_RETRIES + 1).
MAX_RETRIES=5
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=300000
# Rate-limited jobs (Telegram 429 or client-side throttling) are postponed without
# consuming retries for up to this long after receipt.
JOB_RATE_LIMIT_MAX_DEFER_MS=3600000
STEP_TIMEOUT_MS=15000
JOB_TIMEOUT_MS=60000

# --- Secrets (required) ------------------------------------------------------
# Default HMAC secret for endpoints with authType=HMAC (min 16 chars).
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=change-me-generate-with-openssl-rand-hex-32
# 32-byte key (64 hex chars) used to encrypt credentials at rest (AES-256-GCM).
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=v1

# --- Telegram ----------------------------------------------------------------
# Fallback bot token for steps without an attached credential. Get one from @BotFather.
TELEGRAM_BOT_TOKEN=
# Destination channel for workflow steps without a chatId (the Blogger workflow).
# Public channel: @yourchannelusername   Private channel: numeric ID starting with -100
# The bot must be an administrator of the channel with permission to post.
TELEGRAM_CHANNEL_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_POOL_CONNECTIONS=32
TELEGRAM_WARMUP_CONNECTIONS=4
TELEGRAM_KEEP_WARM_INTERVAL_MS=25000
TELEGRAM_INLINE_RETRIES=1
TELEGRAM_RATE_LIMIT_GLOBAL_PER_SEC=30
TELEGRAM_RATE_LIMIT_PER_CHAT_PER_SEC=1
TELEGRAM_RATE_LIMIT_PER_CHAT_BURST=3
TELEGRAM_RATE_LIMIT_MAX_WAIT_MS=50

# --- Outbound HTTP -----------------------------------------------------------
HTTP_TIMEOUT_MS=10000
HTTP_KEEPALIVE_TIMEOUT_MS=60000
# Keep false in production: blocks http.request steps from reaching private networks (SSRF).
HTTP_ALLOW_PRIVATE_NETWORKS=false

# --- Webhook gateway ---------------------------------------------------------
WEBHOOK_BODY_LIMIT_BYTES=262144
WEBHOOK_HMAC_TOLERANCE_SEC=300
# Forward Authorization/Cookie/signature headers to workflows ({{trigger.headers.authorization}}).
WEBHOOK_FORWARD_SENSITIVE_HEADERS=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=1000
IDEMPOTENCY_TTL_SEC=86400
QUEUE_BACKPRESSURE_THRESHOLD=100000
TRUST_PROXY=false

# --- Caching and persistence -------------------------------------------------
CACHE_REFRESH_INTERVAL_MS=30000
RECORDER_FLUSH_INTERVAL_MS=200
RECORDER_MAX_BUFFER=20000
STORE_TRIGGER_PAYLOAD=true
SHUTDOWN_TIMEOUT_MS=25000
